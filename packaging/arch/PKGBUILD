# Maintainer: Mohamed Salahi <264395179+mohamedsalahi@users.noreply.github.com>
pkgname=tachyon-fetch
pkgver=0.7.1
pkgrel=1
pkgdesc='Cockpit-grade system fetch with a built-in configurator and distro logos'
arch=('x86_64' 'aarch64')
url='https://github.com/mohamedsalahi/tachyon-fetch'
license=('MIT')
depends=('gcc-libs' 'fontconfig')
makedepends=('cargo' 'rust')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('9ac4c3269103b91e872a6ee91623a3ed676fa060e3e6840359abc353926cd821')

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --locked
}

check() {
  cd "$pkgname-$pkgver"
  cargo test --release --locked
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/tachyon "$pkgdir/usr/bin/tachyon"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 logos/LICENSE-fastfetch "$pkgdir/usr/share/licenses/$pkgname/LICENSE-fastfetch"
}
